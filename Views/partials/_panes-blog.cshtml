@using DotNetNuke.Web.MvcPipeline.Models
@using DotNetNuke.Web.MvcPipeline.Skins

@model PageModel

@* Page content *@
<main class="skin-main content-wrap">
    @Html.Pane(id: "top_pane_full_width", cssClass: "pane pane-top py-0")
    
    <div class="bg-blue skew-bottom panes mt-0">
        <div class="container">
            <div class="row gx-5">
                <div class="col-12">
                    @Html.Pane(id: "top_pane", cssClass: "pane pane-blue text-white")
                </div>
                <div class="col-12 col-md-6">
                    @Html.Pane(id: "top_pane_left", cssClass: "pane pane-blue text-white")
                </div>
                <div class="col-12 col-md-6">
                    @Html.Pane(id: "top_pane_right", cssClass: "pane pane-blue text-white")
                </div>
            </div>
        </div>
    </div>

    <div class="bg-grey skew-top skew-bottom panes">
        <div class="container">
            <div class="row gx-5">
                <div class="col col-12">
                    @Html.Pane(id: "pane_grey_100", cssClass: "pane pane-grey")
                </div>
                <div class="col col-md-6">
                    @Html.Pane(id: "pane_grey_50_left", cssClass: "pane pane-grey")
                </div>
                <div class="col col-md-6">
                    @Html.Pane(id: "pane_grey_50_right", cssClass: "pane pane-grey")
                </div>
            </div>
        </div>
    </div>

    <div class="skew-top skew-bottom panes">
        <div class="container">
            <div class="row">
                <div class="col col-12">
                    @Html.Pane(id: "contentpane", cssClass: "pane content-pane")
                </div>
            </div>
            <div class="row gx-5">
                <div class="col col-12 col-md-8 main-blog-module">
                    @Html.Pane(id: "blog_pane_left", cssClass: "pane content-pane-66")
                </div>
                <div class="col col-12 col-md-4">
                    @Html.Pane(id: "blog_pane_right", cssClass: "pane content-pane-33")
                </div>
            </div>
            <div class="row">
                <div class="col col-12">
                    @Html.Pane(id: "blog_pane_bottom", cssClass: "pane blog-bottom-pane")
                </div>
            </div>
        </div>
    </div>
</main>

<div class="bg-grey skew-top skew-bottom panes">
    <div class="container">
        <div class="row gx-5">
            <div class="col col-12">
                @Html.Pane(id: "pane_grey_100_bottom", cssClass: "pane pane-grey")
            </div>
        </div>
    </div>
</div>
